DISCORD_BOT_TOKEN=your_bot_token_here
# Optional: instant guild-level slash command sync instead of global (up to 1h delay)
# Get your server ID by enabling Developer Mode in Discord → right-click the server → Copy Server ID
GUILD_ID=0
# Bot status text (shows under the bot name)
STATUS_TEXT=chaosffa.kinetic.host
# Status type: online, idle, dnd, invisible
STATUS_TYPE=online
